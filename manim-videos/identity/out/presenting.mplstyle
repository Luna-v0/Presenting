# Generated by identity/export_matplotlib.py from identity/tokens.yaml. Do not edit by hand — change the tokens and re-run.

figure.facecolor:   "#E4DCC6"
axes.facecolor:     "#E4DCC6"
savefig.facecolor:  "#E4DCC6"
savefig.transparent: False
figure.dpi:         200
savefig.dpi:        200
savefig.bbox:       tight

text.color:         "#232A24"
axes.labelcolor:    "#232A24"
axes.titlecolor:    "#232A24"
xtick.color:        "#5F5A4B"
ytick.color:        "#5F5A4B"
xtick.labelcolor:   "#5F5A4B"
ytick.labelcolor:   "#5F5A4B"

axes.edgecolor:     "#8C8470"
axes.linewidth:     1.2
axes.spines.top:    False
axes.spines.right:  False
axes.grid:          True
grid.color:         "#CFC6AE"
grid.linewidth:     0.8
grid.alpha:         1.0

# Muted first, deliberately. An accent is a categorical encoding with a
# fixed deck-wide meaning, so a two-series chart must not be handed both
# of them just for existing — that spends the encoding by accident, and
# it does it inside a style file where the screenplay validator cannot
# see it. presenting_lib.charts applies an accent only when a beat names
# the series it is about.
# No leading # inside the cycler: it would be stripped as a comment and
# the whole construction becomes unparseable.
axes.prop_cycle:    cycler('color', ['5F5A4B', '8C8470', '3D6349', 'A87F20'])
lines.linewidth:    2.4
lines.solid_capstyle: round
patch.edgecolor:    "#8C8470"
patch.force_edgecolor: True

font.family:        "Liberation Serif"
font.size:          12.0
axes.titlesize:     16.8
axes.labelsize:     12.0
xtick.labelsize:    9.6
ytick.labelsize:    9.6
legend.fontsize:    9.6
legend.frameon:     False

# stroke weight 3.0 / corner radius 0.12 are manim-side; matplotlib has no equivalent.
